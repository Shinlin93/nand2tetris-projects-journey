// File name: projects/1/Or.hdl
/**
 * Or gate:
 * if (a or b) out = 1, else out = 0 
 */
CHIP Or {
    IN a, b;
    OUT out;

    PARTS: 
    Nand(a=a, b=a, out=w1); //input pada logika nand adalah dari 1 jalur input yaitu a
    Nand(a=b, b=b, out=w2); //input pada logika nand adalah dari 1 jalur input yaitu b
    Nand(a=w1, b=w2 , out=out); //input nand dari output nand ke-1 dan output nand ke-2 yaitu w=1 & w2

    
}