/**
 * The ALU (Arithmetic Logic Unit).
 * Computes one of the following functions:
 * x+y, x-y, y-x, 0, 1, -1,
 * x, y, !x, !y, -x, -y,
 * x+1, y+1, x-1, y-1,
 * x&y, x|y
 * on the 16-bit inputs x, y,
 * according to the input bits zx, nx, zy, ny, f, no.
 *
 * if (zx == 1) set x = 0        // 16-bit constant
 * if (nx == 1) set x = !x       // bitwise not
 * if (zy == 1) set y = 0
 * if (ny == 1) set y = !y
 * if (f == 1)  set out = x + y  // integer 2's complement addition
 * if (f == 0)  set out = x & y  // bitwise and
 * if (no == 1) set out = !out   // bitwise not
 *
 * if (out == 0) set zr = 1
 * if (out < 0)  set ng = 1
 */

CHIP ALU {
    IN  
        x[16], y[16],
        zx, nx, zy, ny, f, no;

    OUT 
        out[16],
        zr, ng;

PARTS:
    // --- PEMROSESAN INPUT X ---
    Mux16(a=x, b=false, sel=zx, out=x1); 
    Not16(in=x1, out=Notx1); 
    Mux16(a=x1, b=Notx1, sel=nx, out=NxFinal);

    
    // --- PEMROSESAN INPUT Y ---
    Mux16(a=y, b=false, sel=zy, out=y1);
    Not16(in=y1, out=Noty1);
    Mux16(a=y1, b=Noty1, sel=ny, out=NyFinal);


    // --- PEMILIHAN FUNGSI (f) ---
Add16(a=NxFinal, b=NyFinal, out=FAdd);

And16(a=NxFinal, b=NyFinal, out=FAnd);

Mux16(a=FAnd,b=FAdd, sel=f, out=FFinal);


    
// --- TAHAP AKHIR (no)
// 1. Siapkan opsi negasi untuk output
//2. pilih antara FFinal atau Fnegasi(notFFinal)
    Not16(in=FFinal, out=NotFFinal);
    Mux16(a=FFinal, b=NotFFinal, sel=no, out=outFinal);

//1. pilih antara bit paling kiri(MSB) pada outFInal 
// 1. Tahap Negasi & Output Akhir
// Kita langsung pecah outputnya di sini menjadi beberapa bagian:
// - 'out' untuk output utama chip
// - 'ng' untuk mengambil bit paling kiri (MSB)
// - 'low' dan 'high' untuk mengecek apakah hasilnya nol (zr)

Mux16(a=FFinal, b=NotFFinal, sel=no, 
      out=out,           // Terhubung ke output utama ALU
      out[15]=ng,        // Ambil bit ke-15 untuk flag negative
      out[0..7]=low,     // Ambil 8 bit bawah untuk cek zr
      out[8..15]=high    // Ambil 8 bit atas untuk cek zr
     );

// 2. Logika untuk zr (Zero Flag)
// Jika ada satu saja bit yang bernilai 1, maka orFinal akan 1.
// Kita gunakan Not untuk membaliknya (jika semua 0, maka zr = 1).

Or8Way(in=low, out=or1); // logika OR dipakai untuk mendeteksi apakah ada bit yang bernilai 1
Or8Way(in=high, out=or2); // logika OR dipakai untuk mendeteksi apakah ada bit yang bernilai 1
Or(a=or1, b=or2, out=notZero); //cek apakah ada 1 di seluruh 16 bit
                                //or1 = hasil cek 8 bit bawah
                                //or2 = hasil cek 8 bit atas

Not(in=notZero, out=zr);
}
